#!/bin/sh
# Keep the home LAN on the local interface while Tailscale --accept-routes is on.
# A tailnet node advertises 192.168.7.0/24; Tailscale's table 52 (rule 5270) beats
# main, so replies to LAN devices (TV -> Jellyfin, iLO -> ISO) detour via tailscale0
# and the connection times out. While we hold a 192.168.7.x address, look up main
# first; when away, drop the rule so the subnet route through the tailnet works.
LAN=192.168.7.0/24

case "$2" in
  up|down|dhcp4-change|connectivity-change) ;;
  *) exit 0 ;;
esac

if ip -4 -o addr show | grep -q ' inet 192\.168\.7\.'; then
  ip rule show | grep -q "to $LAN lookup main" || ip rule add to "$LAN" lookup main priority 5000
else
  while ip rule del to "$LAN" lookup main priority 5000 2>/dev/null; do :; done
fi
